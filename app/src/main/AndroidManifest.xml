<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:name=".TextNoteApplication"
        android:supportsRtl="true"
        android:theme="@style/Theme.TextNote">

        <!--
            多实例：同一个应用可以在分屏/桌面窗口里占两块，各显示一份文档。
            - documentLaunchMode="intoExisting"：同一份文档再次打开时**复用**它的窗口，
              不同文档各开一个新窗口；点桌面图标（不带 data）也会新开一个窗口，
              等于顺手给了用户一个「新建窗口」的入口。
            - launchMode **必须是 standard**：singleTask 会把这个 Activity 钉成某个 task 的根，
              再多的 launch 都只会复用同一个 task，多实例直接失效。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:documentLaunchMode="intoExisting"
            android:launchMode="standard"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 用 MIME 类型匹配：content / file 协议 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- 用扩展名兜底：部分文件管理器不给 MIME 类型 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.txt" />
                <data android:pathPattern=".*\\.TXT" />
                <data android:pathPattern=".*\\.md" />
                <data android:pathPattern=".*\\.MD" />
                <data android:pathPattern=".*\\.log" />
                <data android:pathPattern=".*\\.LOG" />
                <data android:pathPattern=".*\\.json" />
                <data android:pathPattern=".*\\.JSON" />
            </intent-filter>
        </activity>
    </application>

</manifest>
